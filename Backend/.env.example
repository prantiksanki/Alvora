# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# MongoDB
MONGO_URI=mongodb://localhost:27017/alvora

# JWT — use a 32+ character random string in production
JWT_SECRET=replace_with_32plus_random_chars_here
JWT_EXPIRES_IN=7d

# Redis (optional — enables caching + BullMQ queues)
REDIS_URL=redis://localhost:6379

# GitHub API (optional but strongly recommended to avoid 60req/hr rate limit)
# Create at: https://github.com/settings/tokens
# Required scopes: public_repo, read:user
GITHUB_TOKEN=

# CORS — set to your deployed frontend URL in production
FRONTEND_URL=http://localhost:5173

# Email — Transactional job alert emails (nodemailer SMTP)
# For Gmail: use App Password (https://myaccount.google.com/apppasswords) with SMTP_HOST=smtp.gmail.com SMTP_PORT=587
# For Brevo/Sendinblue: SMTP_HOST=smtp-relay.brevo.com SMTP_PORT=587
# For Resend SMTP: SMTP_HOST=smtp.resend.com SMTP_PORT=587 SMTP_USER=resend SMTP_PASS=<api-key>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM_NAME=Alvora

# Gmail OAuth2 — Job Application Tracking
# Set up at: https://console.cloud.google.com
# Enable Gmail API, create OAuth 2.0 Web Client credentials
# Add authorized redirect URI: http://localhost:3000/api/emails/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local: http://localhost:3000/api/emails/callback
# Production: https://alvora-backend-ar0h.onrender.com/api/emails/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/emails/callback

# Token encryption — AES-256-GCM key for storing OAuth tokens in MongoDB
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# AI — OpenRouter key for Qwen-powered insights
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Job Monitoring — Real-Time Job Opening Monitor
# Set JOB_MONITOR_ENABLED=true to activate the polling cron jobs
JOB_MONITOR_ENABLED=true
# How long (in seconds) to cache job list API responses
JOB_CACHE_TTL=300
# Priority-tier polling intervals (minutes)
MONITOR_INTERVAL_HIGH=2
MONITOR_INTERVAL_MEDIUM=5
MONITOR_INTERVAL_LOW=15

# AI Resume Tailor — Docker + LaTeX PDF compilation
# Requires Docker Desktop to be running
# Pull the image once: docker pull texlive/texlive:latest
LATEX_DOCKER_IMAGE=texlive/texlive:latest
# Directory where generated .tex and .pdf files are stored
RESUME_STORAGE_PATH=./storage/resumes

# Error tracking (future)
SENTRY_DSN=
