# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# MongoDB
MONGO_URI=mongodb://localhost:27017/alvora

# JWT — use a 32+ character random string in production
JWT_SECRET=replace_with_32plus_random_chars_here
JWT_EXPIRES_IN=7d

# Redis (optional — enables caching + BullMQ queues)
REDIS_URL=redis://localhost:6379

# GitHub API (optional but strongly recommended to avoid 60req/hr rate limit)
# Create at: https://github.com/settings/tokens
# Required scopes: public_repo, read:user
GITHUB_TOKEN=

# CORS — set to your deployed frontend URL in production
FRONTEND_URL=http://localhost:5173

# Email (future — transactional email)
SENDGRID_API_KEY=

# Gmail OAuth2 — Job Application Tracking
# Set up at: https://console.cloud.google.com
# Enable Gmail API, create OAuth 2.0 Web Client credentials
# Add authorized redirect URI: http://localhost:3000/api/emails/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/emails/callback

# Token encryption — AES-256-GCM key for storing OAuth tokens in MongoDB
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# AI — OpenRouter key for Qwen-powered insights
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Job Monitoring — Real-Time Job Opening Monitor
# Set JOB_MONITOR_ENABLED=true to activate the polling cron jobs
JOB_MONITOR_ENABLED=true
# How long (in seconds) to cache job list API responses
JOB_CACHE_TTL=300
# Priority-tier polling intervals (minutes)
MONITOR_INTERVAL_HIGH=2
MONITOR_INTERVAL_MEDIUM=5
MONITOR_INTERVAL_LOW=15

# Error tracking (future)
SENTRY_DSN=
